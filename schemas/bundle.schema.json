{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmecn/emi-recipe-renderer/schemas/bundle.schema.json",
  "title": "EMI bundle.json",
  "description": "Top-level manifest at the EMI export bundle root.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "layoutSchema",
    "scale",
    "packMaxBytes",
    "languages",
    "missingIconId",
    "mods"
  ],
  "properties": {
    "schema": { "const": 1 },
    "layoutSchema": { "type": "number" },
    "scale": { "type": "number" },
    "packMaxBytes": { "type": "number", "exclusiveMinimum": 0 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "contains": { "const": "en_us" }
    },
    "missingIconId": { "type": "string", "minLength": 1 },
    "recipeCount": { "type": "integer", "minimum": 0 },
    "mods": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/modEntry" }
    }
  },
  "$defs": {
    "modEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["routes", "packs"],
      "properties": {
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "packs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["file", "bytes"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "bytes": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
