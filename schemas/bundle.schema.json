{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmecn/emi-recipe-renderer/schemas/bundle.schema.json",
  "title": "EMI bundle.json (schema 2)",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "imageScale", "languages", "missingIconId", "recipeCount"],
  "properties": {
    "schema": { "const": 2 },
    "imageScale": { "type": "number", "exclusiveMinimum": 0 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "contains": { "const": "en_us" }
    },
    "missingIconId": { "type": "string", "minLength": 1 },
    "recipeCount": { "type": "integer", "minimum": 0 },
    "recipeImageFormat": {
      "type": "string",
      "enum": ["png", "webp"],
      "default": "png"
    }
  }
}
