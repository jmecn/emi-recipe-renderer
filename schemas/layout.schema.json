{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmecn/emi-recipe-renderer/schemas/layout.schema.json",
  "title": "EMI recipe layout",
  "description": "Single recipe layout body inside a layout pack layouts map.",
  "type": "object",
  "additionalProperties": true,
  "required": ["widgets"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "panel": { "type": "object" },
    "widgets": {
      "type": "array"
    }
  }
}
