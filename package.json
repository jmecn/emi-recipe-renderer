{
  "name": "emi-recipe-renderer",
  "version": "0.5.4",
  "description": "Browser renderer for exported EMI recipe layouts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "files": [
    "dist",
    "schemas",
    "src/gtceu-translate.js",
    "src/registry-label.mjs",
    "src/validate",
    "SCHEMA.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/emi.min.js",
  "style": "./dist/emi.min.css",
  "unpkg": "./dist/emi.min.js",
  "jsdelivr": "./dist/emi.min.js",
  "browser": "./dist/emi.min.js",
  "exports": {
    ".": {
      "import": "./dist/emi.js",
      "default": "./dist/emi.min.js"
    },
    "./emi.js": "./dist/emi.js",
    "./emi.min.js": "./dist/emi.min.js",
    "./emi.css": "./dist/emi.css",
    "./emi.min.css": "./dist/emi.min.css",
    "./style.css": "./dist/emi.min.css",
    "./validate": "./src/validate/index.mjs",
    "./validate/cli": "./src/validate/cli.mjs",
    "./schemas/bundle.schema.json": "./schemas/bundle.schema.json",
    "./schemas/recipe-meta.schema.json": "./schemas/recipe-meta.schema.json",
    "./gtceu-translate.js": "./src/gtceu-translate.js",
    "./registry-label.mjs": "./src/registry-label.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "emi-bundle-validate": "./src/validate/cli.mjs"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "node --test tests/*.test.mjs",
    "validate": "node src/validate/cli.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "emi",
    "minecraft",
    "recipe",
    "renderer"
  ],
  "author": "jmecn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmecn/emi-recipe-renderer.git"
  },
  "bugs": {
    "url": "https://github.com/jmecn/emi-recipe-renderer/issues"
  },
  "homepage": "https://github.com/jmecn/emi-recipe-renderer#readme"
}
