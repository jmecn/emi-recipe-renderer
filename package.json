{
  "name": "emi-recipe-renderer",
  "version": "0.2.1",
  "description": "Browser renderer for exported EMI recipe layouts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/emi.min.js",
  "style": "./dist/emi.min.css",
  "unpkg": "./dist/emi.min.js",
  "jsdelivr": "./dist/emi.min.js",
  "browser": "./dist/emi.min.js",
  "exports": {
    ".": {
      "import": "./dist/emi.js",
      "default": "./dist/emi.min.js"
    },
    "./emi.js": "./dist/emi.js",
    "./emi.min.js": "./dist/emi.min.js",
    "./emi.css": "./dist/emi.css",
    "./emi.min.css": "./dist/emi.min.css",
    "./style.css": "./dist/emi.min.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "emi",
    "minecraft",
    "recipe",
    "renderer"
  ],
  "author": "jmecn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmecn/emi-recipe-renderer.git"
  },
  "bugs": {
    "url": "https://github.com/jmecn/emi-recipe-renderer/issues"
  },
  "homepage": "https://github.com/jmecn/emi-recipe-renderer#readme"
}
